<Window x:Class="XmlSearch.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Pesquisa XML TIA" Height="760" Width="1250" MinHeight="600" MinWidth="950">
  <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Pasta fonte:" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Grid.Column="1" x:Name="SourceRootTextBox" VerticalContentAlignment="Center"/><Button Grid.Column="2" x:Name="ReindexButton" Content="Reindexar" Padding="18,6" Margin="10,0,0,0" Click="Reindex_Click"/>
    </Grid>
    <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Pesquisar"/><TextBox x:Name="QueryTextBox" Height="28" VerticalContentAlignment="Center" KeyUp="Query_KeyUp"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Projetos"/><ListBox x:Name="ProjectsList" Height="70" SelectionMode="Multiple" SelectionChanged="Filters_Changed"/></StackPanel>
      <StackPanel Grid.Column="2" Margin="10,0,0,0"><TextBlock Text="CPUs"/><ListBox x:Name="CpusList" Height="70" SelectionMode="Multiple" SelectionChanged="Filters_Changed"/></StackPanel>
      <StackPanel Grid.Column="3" Margin="10,0,0,0"><TextBlock Text="Tipo de elemento"/><ListBox x:Name="KindsList" Height="70" SelectionMode="Multiple" SelectionChanged="Filters_Changed"/></StackPanel>
      <Button Grid.Column="4" Content="Limpar filtros" Margin="10,20,0,0" Padding="12,6" VerticalAlignment="Top" Click="Clear_Click"/>
    </Grid>
    <DataGrid Grid.Row="2" x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Results_SelectionChanged" CanUserAddRows="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="*"/><DataGridTextColumn Header="Dado" Binding="{Binding DataType}" Width="*"/><DataGridTextColumn Header="Projeto" Binding="{Binding Project}" Width="*"/><DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="*"/><DataGridTextColumn Header="Seção" Binding="{Binding Section}" Width="*"/><DataGridTextColumn Header="Network" Binding="{Binding NetworkDisplay}" Width="*"/><DataGridTextColumn Header="Localização" Binding="{Binding RelativePath}" Width="3*"/>
      </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="OpenButton" Content="Abrir XML" Padding="18,6" IsEnabled="False" Click="Open_Click"/></Grid>
  </Grid>
</Window>
